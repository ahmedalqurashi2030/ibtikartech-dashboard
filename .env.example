DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DEFAULT_FROM_EMAIL=Ibtikar Tech <no-reply@example.com>

# One-time bootstrap for /control/ access
IBTIKAR_ADMIN_EMAIL=
IBTIKAR_ADMIN_PASSWORD=
IBTIKAR_SITE_HOSTNAME=localhost

# Production PostgreSQL (required by config.settings.production)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Production email (recommended; required for real customer email verification)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Optional S3-compatible media storage. Leave bucket empty for persistent local media.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_ADDRESSING_STYLE=
AWS_MEDIA_LOCATION=media

# Production process
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60


# External analytics vendors remain off unless explicitly enabled in production.
ENABLE_EXTERNAL_TRACKING=false
